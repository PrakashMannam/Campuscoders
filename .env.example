# Env files for the API live next to the backend (not at repo root).
#
# 1. Copy:
#      backend/.env.example  →  backend/.env
# 2. Fill MAIL_* / DB_* / JWT_SECRET
# 3. Start API from the backend folder:
#      cd backend && mvn spring-boot:run
#
# spring-dotenv loads backend/.env into Spring's Environment.
# application.yml maps them, e.g. spring.mail.host: ${MAIL_HOST:}
#
# Frontend (optional):
#   frontend/campus_coders/.env
#   REACT_APP_API_URL=http://localhost:8080/api
