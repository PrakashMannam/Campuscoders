# Copy to backend/.env (same folder as pom.xml). Do not commit .env.
# Spring Boot reads these via spring-dotenv when you start from the backend directory.
# OS / IDE environment variables override values from .env.

DB_URL=jdbc:mysql://localhost:3306/campuscoders
DB_USERNAME=root
DB_PASSWORD=root

# Generate a strong secret, e.g. PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

FRONTEND_URL=http://localhost:3000
SPRING_PROFILES_ACTIVE=dev

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Preferred on Railway Hobby (SMTP is blocked). HTTPS API — do not commit real keys.
RESEND_API_KEY=

GITHUB_TOKEN=
